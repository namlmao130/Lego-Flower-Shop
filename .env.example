# ===================================================================
# LEGO FLOWER SHOP - FILE CẤU HÌNH MẪU (.env.example)
# Sao chép file này thành ".env" và điền các thông tin bí mật thực tế.
# KHÔNG BAO GIỜ commit file .env chứa mật khẩu thật lên Git!
# ===================================================================

# Chuỗi bí mật mã hóa Session & CSRF Token (Bắt buộc đổi trước khi deploy)
SECRET_KEY=thay-doi-chuoi-ngau-nhien-dai-va-bao-mat-tai-day

# Database URI (Bỏ trống để dùng SQLite shop.db mặc định, hoặc điền PostgreSQL)
# Ví dụ PostgreSQL: postgresql://user:password@localhost:5432/shop_db
DATABASE_URL=

# Mật khẩu quản trị viên (Admin) cho lần đầu khởi tạo DB (Nếu bỏ trống sẽ tự sinh ngẫu nhiên)
ADMIN_PASSWORD=

# Cấu hình gửi email (Tính năng quên & đặt lại mật khẩu)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=Lego Flower <your-email@gmail.com>

# Cấu hình Redis (Tùy chọn: dùng chung Cache & Rate Limit cho nhiều worker Gunicorn)
REDIS_URL=

# Đặt "true" nếu app chạy sau Reverse Proxy tin cậy (Nginx, Render, Railway, Cloudflare...)
TRUST_PROXY=false

# Đặt "true" để ép buộc Cookie an toàn qua HTTPS
SESSION_COOKIE_SECURE=false
