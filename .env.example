# Copy file này thành ".env" và điền giá trị thật (KHÔNG commit file .env lên Git)

# Bắt buộc đổi trước khi deploy thật
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai-va-bi-mat

# Database — bỏ trống để dùng SQLite mặc định (shop.db), hoặc điền nếu dùng PostgreSQL/MySQL
DATABASE_URL=

# Gửi email (tính năng quên mật khẩu)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Lego Flower <noreply@legoflower.com>

# --- Hiệu năng / chịu tải nhiều truy cập đồng thời ---

# Để trống = cache + rate-limit dùng RAM (đủ cho đồ án, traffic nhỏ, chạy 1 worker).
# Điền vào = dùng Redis, CHÍNH XÁC hơn khi chạy nhiều worker/nhiều máy (xem config.py).
REDIS_URL=

# Đặt "true" CHỈ KHI app chạy sau 1 reverse proxy đáng tin cậy (Nginx, hoặc hạ tầng
# của Render/Railway/Heroku...). Nếu app lộ trực tiếp ra Internet, PHẢI để false/để trống
# — bật nhầm sẽ cho phép giả mạo IP để né rate-limit (xem giải thích trong web.py).
TRUST_PROXY=false
